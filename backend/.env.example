APP_NAME=GovOrchestrator AI
APP_ENV=local
DEBUG=true
API_PREFIX=/api
SQLITE_DB_PATH=data/sqlite/database.db
DATA_DIR=data
SQLITE_DIR=data/sqlite
UPLOADS_DIR=data/uploads
REPORTS_DIR=data/reports
LANGGRAPH_MAX_STEPS=25
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_NUM_PREDICT=768
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_SECONDS=30
ENABLE_LLM_CALLS=false

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=room_steps

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=room-artifacts
S3_KNOWLEDGE_PREFIX=knowledge
S3_REPORTS_PREFIX=reports

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
ENABLE_SENTENCE_TRANSFORMER=false
